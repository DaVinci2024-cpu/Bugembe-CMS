rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: everything is denied unless a more specific match below allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Hardcoded on purpose: Firestore rules cannot read env vars, and this lets
    // the very first login bootstrap itself into an approved admin with zero
    // Cloud Functions. Must be kept in sync with NEXT_PUBLIC_SUPER_ADMIN_EMAIL.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == "bugembeislamic1971@gmail.com";
    }

    // True if the caller is approved and holds the given module permission,
    // or is the super admin (who implicitly holds every permission).
    function hasModulePermission(moduleKey) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[moduleKey] == true
      );
    }

    // Approved admin with the "users" permission (or the super admin) — the
    // gate for approving accounts and reading the audit trail.
    function isUserAdmin() {
      return hasModulePermission('users');
    }

    function isValidUserDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'permissions', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 15
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.status is string && data.status in ['pending', 'approved', 'rejected', 'suspended', 'revoked']
        && data.permissions is map
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // ---- Users & audit log ----

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isUserAdmin());
      allow list: if isUserAdmin();

      // Lazy self-registration on first sign-in. Always starts pending.
      // Note: createdAt/updatedAt are client-generated ISO strings (not
      // Firestore server timestamps), so they can't be checked against
      // request.time for equality — that's covered by isValidUserDoc's type
      // check instead.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidUserDoc(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isSignedIn() && isValidId(userId) && isValidUserDoc(incoming()) && (
        isUserAdmin() ||
        (
          // Owners may only touch their own display name / photo, never their
          // own status, permissions or expiry.
          request.auth.uid == userId
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().status == existing().status
          && incoming().permissions == existing().permissions
          && incoming().temporaryAccessExpiry == existing().temporaryAccessExpiry
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        )
      );

      allow delete: if isUserAdmin();
    }

    match /adminActivityLogs/{logId} {
      allow read: if isUserAdmin();

      allow create: if isUserAdmin()
        && isValidId(logId)
        && incoming().id is string
        && incoming().adminUid == request.auth.uid
        && incoming().adminEmail == request.auth.token.email
        && incoming().createdAt is string;

      allow update, delete: if false; // append-only
    }

    // ---- Public content collections ----
    // Public site pages read these directly (via ISR, not per-visitor), so
    // reads stay open. Writes require the matching module permission.

    match /news/{articleId} {
      // Anyone can read a published article by ID; only admins with the
      // "blogs" permission can read drafts. Docs written before the status
      // field existed are treated as published too, so nothing already live
      // disappears — every write from now on is required to set it (see
      // the create/update rule below). "list" queries follow the same rule,
      // which is why the public repository must explicitly filter
      // where("status","==","published") — Firestore denies the whole
      // query outright if it can't prove every possible result matches.
      allow get, list: if (!('status' in resource.data) || resource.data.status == 'published') || hasModulePermission('blogs');
      allow create, update: if hasModulePermission('blogs') && isValidId(articleId) && (
        incoming().keys().hasAll(['title', 'slug', 'excerpt', 'content', 'category', 'date', 'author', 'image', 'featured', 'readTime', 'status'])
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().slug is string && incoming().slug.matches('^[a-z0-9\\-]+$')
        && incoming().excerpt is string
        && incoming().content is string
        && incoming().category is string
        && incoming().date is string
        && incoming().author is string
        && incoming().image is string
        && incoming().featured is bool
        && incoming().readTime is string
        && incoming().status is string && incoming().status in ['draft', 'published']
        && (!('videoUrl' in incoming()) || incoming().videoUrl is string)
      );
      allow delete: if hasModulePermission('blogs');
    }

    match /programs/{programId} {
      // Same draft/published visibility as /news — see that block's comment.
      allow get, list: if (!('status' in resource.data) || resource.data.status == 'published') || hasModulePermission('programs');
      allow create, update: if hasModulePermission('programs') && isValidId(programId) && (
        incoming().keys().hasAll(['title', 'level', 'shortDescription', 'longDescription', 'curriculum', 'duration', 'admissionRequirements', 'feesPlaceholder', 'image', 'featured', 'status'])
        && incoming().title is string
        && incoming().level is string
        && incoming().shortDescription is string
        && incoming().longDescription is string
        && incoming().curriculum is list
        && incoming().duration is string
        && incoming().admissionRequirements is list
        && incoming().feesPlaceholder is string
        && incoming().image is string
        && incoming().featured is bool
        && incoming().status is string && incoming().status in ['draft', 'published']
      );
      allow delete: if hasModulePermission('programs');
    }

    match /gallery/{itemId} {
      // Same draft/published visibility as /news — see that block's comment.
      allow get, list: if (!('status' in resource.data) || resource.data.status == 'published') || hasModulePermission('gallery');
      allow create, update: if hasModulePermission('gallery') && isValidId(itemId) && (
        incoming().keys().hasAll(['title', 'description', 'category', 'image', 'date', 'status'])
        && incoming().title is string
        && incoming().description is string
        && incoming().category is string
        && incoming().image is string
        && incoming().date is string
        && incoming().status is string && incoming().status in ['draft', 'published']
      );
      allow delete: if hasModulePermission('gallery');
    }

    match /testimonials/{testimonialId} {
      // Same draft/published visibility as /news — see that block's comment.
      allow get, list: if (!('status' in resource.data) || resource.data.status == 'published') || hasModulePermission('testimonials');
      allow create, update: if hasModulePermission('testimonials') && isValidId(testimonialId) && (
        incoming().keys().hasAll(['name', 'role', 'quote', 'avatar', 'rating', 'status'])
        && incoming().name is string
        && incoming().role is string
        && incoming().quote is string
        && incoming().avatar is string
        && incoming().rating is number
        && incoming().status is string && incoming().status in ['draft', 'published']
        && (!('graduationYear' in incoming()) || incoming().graduationYear is number)
      );
      allow delete: if hasModulePermission('testimonials');
    }

    // Alumni directory: anyone can submit their own profile (always forced to
    // pending, unfeatured — mirrors the approval workflow used for staff
    // accounts). Admins with the "alumni" permission can additionally create
    // a profile with any status/featured value directly (importing seed
    // data, or adding an already-approved entry without a review step).
    match /alumni/{profileId} {
      allow read: if true;
      allow create: if isValidId(profileId) && (
        incoming().keys().hasAll(['fullName', 'graduationYear', 'profession', 'organization', 'country', 'city', 'phone', 'email', 'photo', 'bio', 'featured', 'status'])
        && incoming().fullName is string
        && incoming().graduationYear is number
        && incoming().profession is string
        && incoming().organization is string
        && incoming().country is string
        && incoming().city is string
        && incoming().phone is string
        && incoming().email is string
        && incoming().photo is string
        && incoming().bio is string
        && incoming().status in ['pending', 'approved']
        && (
          hasModulePermission('alumni')
          || (incoming().featured == false && incoming().status == 'pending')
        )
      );
      allow update, delete: if hasModulePermission('alumni');
    }

    // Site-wide settings: hero, statistics, branding, header announcements,
    // contact info, WhatsApp departments, homepage advantages/achievements.
    // Single well-known document IDs, no free-form doc creation.
    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update: if hasModulePermission('homepage') && (
        (docId == 'hero' &&
          incoming().keys().hasAll(['headline', 'subheadline', 'bgImage', 'ctaPrimaryText', 'ctaPrimaryLink', 'ctaSecondaryText', 'ctaSecondaryLink'])
          && incoming().headline is string
          && incoming().subheadline is string
          && incoming().bgImage is string
          && incoming().ctaPrimaryText is string
          && incoming().ctaPrimaryLink is string
          && incoming().ctaSecondaryText is string
          && incoming().ctaSecondaryLink is string)
        ||
        (docId == 'statistics' && incoming().keys().hasAll(['items']) && incoming().items is list)
        ||
        (docId == 'branding' &&
          incoming().keys().hasAll(['logoUrl', 'siteName', 'tagline', 'brandBlurb', 'certificationText', 'primaryColor', 'primaryColorHover', 'accentColor'])
          && incoming().logoUrl is string
          && incoming().siteName is string
          && incoming().tagline is string
          && incoming().brandBlurb is string
          && incoming().certificationText is string
          && incoming().primaryColor is string
          && incoming().primaryColorHover is string
          && incoming().accentColor is string)
        ||
        (docId == 'header' && incoming().keys().hasAll(['announcements']) && incoming().announcements is list)
        ||
        (docId == 'contact' &&
          incoming().keys().hasAll(['address', 'phone', 'email', 'whatsappNumber', 'facebookUrl', 'officeHours', 'quickContacts', 'mapEmbedUrl'])
          && incoming().address is string
          && incoming().phone is string
          && incoming().email is string
          && incoming().whatsappNumber is string
          && incoming().facebookUrl is string
          && incoming().officeHours is string
          && incoming().quickContacts is list
          && incoming().mapEmbedUrl is string)
        ||
        (docId == 'whatsappDepartments' && incoming().keys().hasAll(['items']) && incoming().items is list)
        ||
        (docId == 'advantages' && incoming().keys().hasAll(['items']) && incoming().items is list)
        ||
        (docId == 'achievements' && incoming().keys().hasAll(['items']) && incoming().items is list)
        ||
        (docId == 'founderMessage' &&
          incoming().keys().hasAll(['photo', 'icon', 'eyebrow', 'heading', 'message', 'name', 'title', 'badgeText'])
          && incoming().photo is string
          && incoming().icon is string
          && incoming().eyebrow is string
          && incoming().heading is string
          && incoming().message is string
          && incoming().name is string
          && incoming().title is string
          && incoming().badgeText is string)
        ||
        (docId == 'alumniSpotlight' &&
          incoming().keys().hasAll(['photo', 'badge', 'name', 'quote', 'currentRole', 'location'])
          && incoming().photo is string
          && incoming().badge is string
          && incoming().name is string
          && incoming().quote is string
          && incoming().currentRole is string
          && incoming().location is string)
        ||
        (docId == 'communityGroups' && incoming().keys().hasAll(['items']) && incoming().items is list)
        ||
        (docId == 'highlights' && incoming().keys().hasAll(['items']) && incoming().items is list)
        ||
        (docId == 'sectionOrder' && incoming().keys().hasAll(['order']) && incoming().order is list)
      );
      allow delete: if false;
    }

    // Admissions page copy (process/requirements/FAQs) — single doc, same
    // pattern as siteSettings. This is site settings, not postable content,
    // so there's no draft/published status — saves go live immediately.
    match /admissionsContent/{docId} {
      allow read: if true;
      allow write: if hasModulePermission('admissions') && docId == 'main' && (
        incoming().keys().hasAll(['process', 'requirements', 'faqs'])
        && incoming().process is list
        && incoming().requirements is map
        && incoming().requirements.general is list
        && incoming().requirements.boardingList is list
        && incoming().faqs is list
      );
    }

    // About Us page content — single doc, same pattern as admissionsContent.
    match /aboutPage/{docId} {
      allow read: if true;
      allow write: if hasModulePermission('about') && docId == 'main' && (
        incoming().keys().hasAll(['historyImage', 'history', 'mission', 'vision', 'coreValues', 'leadershipMessage', 'facilities'])
        && incoming().historyImage is string
        && incoming().history is string
        && incoming().mission is string
        && incoming().vision is string
        && incoming().coreValues is list
        && incoming().leadershipMessage is map
        && incoming().leadershipMessage.author is string
        && incoming().leadershipMessage.role is string
        && incoming().leadershipMessage.avatar is string
        && incoming().leadershipMessage.quote is string
        && incoming().facilities is list
      );
    }

  }
}
