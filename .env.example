# Powers the "Al-Aleem" AI chat widget (Gemini via @google/genai). Get a key
# from https://aistudio.google.com/apikey — free tier is enough for this
# site's traffic. If unset, the chat widget falls back to a static demo
# response instead of failing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Firebase (admin console) ---
# From your Firebase project's Web App config (Project Settings > General).
# These are public/client-side keys (NEXT_PUBLIC_*) — Firestore/Auth access is
# actually enforced by firestore.rules, not by keeping these secret.
NEXT_PUBLIC_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="MY_PROJECT.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="MY_APP_ID"

# The Google account email that should be auto-approved with full admin
# permissions on first sign-in. Must exactly match the literal hardcoded into
# isSuperAdmin() in firestore.rules (Firestore rules can't read env vars).
NEXT_PUBLIC_SUPER_ADMIN_EMAIL="superadmin@example.com"

# Absolute base URL used for the sitemap, canonical links, and Open Graph
# tags. Update this if the domain ever changes.
NEXT_PUBLIC_SITE_URL="https://example.com"

# --- Google Analytics (optional) ---
# GA4 Measurement ID from analytics.google.com (Admin > Data Streams > your
# web stream). Only loads on public pages, never the admin console. Leave
# unset to skip Analytics entirely — nothing breaks either way.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Cloudinary (image uploads in the admin panel) ---
# Firebase Storage requires the paid Blaze plan even to enable, so image
# uploads go through Cloudinary's free tier instead (no credit card needed).
# From cloudinary.com dashboard: cloud name shown at the top; upload preset
# from Settings > Upload > Upload presets (must be an "Unsigned" preset).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="MY_CLOUD_NAME"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="MY_UNSIGNED_UPLOAD_PRESET"
